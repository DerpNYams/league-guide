<%- include("partials/header") %>
<section class="section two-column">
  <div>
    <p class="eyebrow">Contact information</p>
    <h1>Get in touch</h1>
    <p>Send a question or suggest a champion that should be added next.</p>
    <div class="contact-info">
      <p><strong>Email</strong><br>leagueguide@example.com</p>
      <p><strong>Discord</strong><br>leagueguideclub</p>
      <p><strong>Club meeting</strong><br>Student Center, Room 112</p>
    </div>
  </div>
  <form action="/contact" method="post" class="panel">
    <label>Name<input name="name" required maxlength="80"></label>
    <label>Email<input type="email" name="email" required maxlength="120"></label>
    <label>Message<textarea name="message" rows="6" required maxlength="1000"></textarea></label>
    <button class="button" type="submit">Send message</button>
  </form>
</section>
<%- include("partials/footer") %>
